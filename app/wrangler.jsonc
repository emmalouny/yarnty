{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yarnty-tracker",
  "compatibility_date": "2026-10-22",

  // An assets-only Worker: no server code, just the built PWA. The _headers
  // file in public/ still applies, which is what keeps sw.js uncached.
  "assets": {
    "directory": "./dist",
    // Unknown paths fall back to index.html so client-side routes work when
    // they arrive in week 2.
    "not_found_handling": "single-page-application"
  },

  // The tracker lives on dev.yarnty.com while it is being built. yarnty.com
  // keeps the Coming soon page until the tracker is good enough to be the
  // product — at which point this becomes "yarnty.com" and the landing page
  // Worker gives the domain back.
  "routes": [
    { "pattern": "dev.yarnty.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
